# .env.local에 복사하고 실제 값을 입력합니다.

# ─── AI 추론 (OpenAI 호환 프로토콜 중 하나 선택) ───
# 참고: 오픈 소스 버전에는 /api/interpret와 같은 백엔드 인터페이스가 포함되어 있지 않습니다. 다음 구성 세트는 인터페이스를 직접 구현한 후에만 사용됩니다.
# 배반, 명반만 보고 싶다면 따로 작성하지 않으셔도 됩니다.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 아니면 다른 OpenAI 호환 모델을 사용하세요 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 사이트 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
